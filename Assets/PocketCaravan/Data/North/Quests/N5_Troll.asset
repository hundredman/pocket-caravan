  id: north_q5_troll
  retired: 0
  title: "\uB2E4\uB9AC \uBC11 \uD2B8\uB864"
  chain: "\uBE48 \uB4F1\uC9D0\uC5D0\uC11C \uC190\uC218\uB808\uAE4C\uC9C0"
  summary: "\uD53C\uC624\uB974 \uB098\uB8E8 \uCC3D\uACE0\uC9C0\uAE30\uAC00 \uB9E1\uAE34
    \uC18C\uAE08 \uB369\uC774\uB97C \uC0AC\uB0E5\uAFBC \uB9C8\uC744\uC758 \uC21C\uB85D\uC9C0\uAE30
    \uC0BC\uD615\uC81C\uC5D0\uAC8C \uBC30\uB2EC\uD55C\uB2E4. \uB098\uB8E8 \uBD81\uCABD
    \uAC08\uB9BC\uAE38(\uB77C\uC6B0\uAC00\uB974\uB85C \uAC00\uB294 \uC9C0\uB984\uAE38)\uC5D4
    \uD2B8\uB864 \uD328\uAC70\uB9AC\uAC00 \uC0B0\uB2E4. \uB3CC\uC544\uAC00\uB824\uBA74
    \uC11C\uCABD \uBE44\uB974\uCE74 \uAE38\uB85C."
  giverNpc: north_warehouse
  requires:
  - {fileID: 11400000, guid: 4fedf6281e4284f77b4d0ceeef3e5f7e, type: 2}
  requiresAny: []
  choiceGroup: 
  offerLine: "\uBC30\uB85C \uB4E4\uC5B4\uC628 \uC18C\uAE08 \uB369\uC774\uC57C. \uC0AC\uB0E5\uAFBC
    \uB9C8\uC744 \uC21C\uB85D\uC9C0\uAE30 \uC0BC\uD615\uC81C\uAC00 \uC21C\uB85D\uD55C\uD14C
    \uD565\uAC8C \uD55C\uB2E4\uACE0 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC9C0. \uBD81\uCABD
    \uAC08\uB9BC\uAE38\uB85C \uB77C\uC6B0\uAC00\uB974\uB97C \uAC70\uCCD0 \uAC00\uBA74
    \uBE60\uB978\uB370, \uAC70\uAE30 \uD2B8\uB864 \uD328\uAC70\uB9AC\uAC00 \uC0B4\uC544.
    \uD1B5\uD589\uB8CC\uB97C \uB0B4\uB4E0, \uB0C5\uB2E4 \uB2EC\uB9AC\uB4E0, \uC11C\uCABD
    \uBE44\uB974\uCE74\uB85C \uB3CC\uC544\uAC00\uB4E0 \uC790\uB124\uAC00 \uC815\uD558\uAC8C."
