  id: north_q7_cart
  retired: 0
  title: "\uD558\uB974\uC758 \uC9D0 \uC370\uB9E4"
  chain: "\uBE48 \uB4F1\uC9D0\uC5D0\uC11C \uC9D0 \uC370\uB9E4\uAE4C\uC9C0"
  summary: "\uB3C8\uC744 \uBAA8\uC544 \uBE44\uB974\uCE74 \uC7A5\uD130\uC5D0\uC11C \uC9D0 \uC370\uB9E4\uB97C \uC0AC\uACE0 \uBAA9\uC218 \uD558\uB974\uC5D0\uAC8C \uBCF4\uC5EC\uC900\uB2E4. \uD55C \uBC88\uC5D0 \uC138 \uBC30\uB97C \uC2E4\uC744 \uC218 \uC788\uB2E4."
  giverNpc: north_har
  requires:
  - {fileID: 11400000, guid: 4fedf6281e4284f77b4d0ceeef3e5f7e, type: 2}
  requiresAny: []
  choiceGroup: 
  offerLine: "\uB4F1\uC9D0\uC73C\uB85C\uB294 \uD558\uB8E8\uC5D0 \uBA87 \uBC88 \uBABB \uC624\uAC00\uC9C0. \uB0B4\uAC00 \uB9CC\uB4E0 \uC9D0 \uC370\uB9E4\uB294 \uBE44\uB974\uCE74 \uC7A5\uD130\uC5D0\uC11C \uD310\uB2E4\uB124. \uBD81\uCABD \uB208\uAE38\uC5D0\uC120 \uBC14\uD034\uBCF4\uB2E4 \uC370\uB9E4\uAC00 \uB0AB\uC9C0. \uC758\uB8B0\uC640 \uC7A5\uC0AC\uB85C \uB3C8\uC744 \uBAA8\uC544\uC11C \uC0AC \uAC00\uAC8C."
  giveItem: {fileID: 0}
  giveCount: 0
  offerItem: {fileID: 0}
  offerCount: 0
  offerPrice: 0
  objectives:
  - type: 7
    text: "\uC9D0 \uC370\uB9E4 \uAC12 150\uB0E5 \uBAA8\uC73C\uAE30"
    targetId: 
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 150
    completeLine: 
  - type: 6
    text: "\uBE44\uB974\uCE74 \uC7A5\uD130\uC5D0\uC11C \uC9D0 \uC370\uB9E4 \uC0AC\uAE30"
    targetId: 
    item: {fileID: 0}
    vehicle: {fileID: 11400000, guid: fe513768e4d8d4b289301536cf9f0a44, type: 2}
    count: 1
    completeLine: 
  - type: 0
    text: "\uBAA9\uC218 \uD558\uB974\uC5D0\uAC8C \uBCF4\uC5EC\uC8FC\uAE30"
    targetId: north_har
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 1
    completeLine: "\uC798 \uBBF8\uB044\uB7EC\uC9C0\uC9C0? \uADF8\uB7F0\uB370 \uC9D0\uC744 \uB354 \uC2E4\uC73C\uB824\uBA74 \uB9D0\uC774 \uC788\uC5B4\uC57C \uD558\uB124. \uC21C\uB85D \uACE0\uC6D0 \uB9C8\uC744\uC758 \uC370\uB9E4 \uC7A5\uC778 \uC601\uAC10\uC774 \uC9D0\uB9D0 \uC548\uC7A5\uC744 \uC9D3\uB294\uB2E4\uB354\uAD70.\n\uBE44\uB974\uCE74 \uC11C\uCABD \uAE38\uB85C \uBAA8\uD53C \uC0AC\uB0E5\uAFBC \uB9C8\uC744\uC5D0 \uAC00\uC11C, \uBD81\uCABD \uAE38\uB85C \uB354 \uC62C\uB77C\uAC00\uBA74 \uC21C\uB85D \uACE0\uC6D0 \uB9C8\uC744\uC774\uC57C. \uD55C\uBC88 \uCC3E\uC544\uAC00 \uBCF4\uAC8C."
  rewardMoney: 0
  rewardCredit: 0
  rewardReputationScope: 0
  rewardReputationTarget: north
  rewardReputationSize: 2
  hasLegacyReward: 0
  legacyRewardMoney: 0
  legacyRewardCredit: 0
  finishNote: "\uC9D0 \uC370\uB9E4\uB97C \uC0C0\uB2E4! 1\uC7A5 \uB05D.\n\uB2E4\uC74C: \uC21C\uB85D \uACE0\uC6D0 \uB9C8\uC744\uC758 \uC370\uB9E4 \uC7A5\uC778\uC744 \uCC3E\uC544\uAC00 \uBCF4\uC790. (\uBE44\uB974\uCE74 \uC11C\uCABD \u2192 \uBAA8\uD53C \uC0AC\uB0E5\uAFBC \uB9C8\uC744 \u2192 \uBD81\uCABD \uAE38)"
