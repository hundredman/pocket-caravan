  m_Name: N8_Sled
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.QuestData
  id: north_q8_sled
  retired: 0
  title: "\uB208\uBCF4\uB77C\uB97C \uB2EC\uB9AC\uB294 \uC370\uB9E4"
  chain: "\uBD81\uCABD\uC758 \uAE38"
  summary: "\uC21C\uB85D \uACE0\uC6D0\uC758 \uC370\uB9E4 \uC7A5\uC778\uC774 \uD558\uB974\uC758
    \uC190\uC218\uB808\uC5D0 \uC9C0\uC9C0 \uC54A\uC744 \uC9D0 \uC370\uB9E4\uB97C
    \uB9CC\uB4E0\uB2E4. \uAE54\uAC1C\uB85C \uC4F8 \uBAA8\uD53C\uB97C \uAC00\uC838\uB2E4\uC8FC\uACE0,
    \uACE0\uC6D0 \uC7A5\uD130\uC5D0\uC11C \uC370\uB9E4\uB97C \uC0AC\uC11C \uBE44\uB974\uCE74
    \uB0A8\uCABD \uBD81\uBB38 \uB9C8\uC744\uAE4C\uC9C0 \uB2EC\uB824 \uBCF8\uB2E4."
  giverNpc: north_sledmaker
  requires:
  - {fileID: 11400000, guid: ac84adc9db6ec4c3bb27dcb61b94b8c5, type: 2}
  requiresAny: []
  choiceGroup: 
  offerLine: "\uD558\uB974 \uB140\uC11D \uC190\uC218\uB808\uB97C \uC0C0\uB2E4\uACE0?
    \uB208\uAE38\uC5D0\uC120 \uBC14\uD034\uAC00 \uBE60\uC9C4\uB2E4\uB124. \uB0B4\uAC00
    \uC81C\uB300\uB85C \uB41C \uC9D0 \uC370\uB9E4\uB97C \uB9CC\uB4E4\uC5B4 \uC8FC\uC9C0.
    \uAE54\uAC1C\uB85C \uC4F8 \uBAA8\uD53C \uC138 \uC7A5\uB9CC \uAC00\uC838\uB2E4\uC8FC\uACA0\uB098?
    \uB2E4 \uB418\uBA74 \uACE0\uC6D0 \uC7A5\uD130\uC5D0 \uB0B4\uB193\uACA0\uB124."
  giveItem: {fileID: 0}
  giveCount: 0
  offerItem: {fileID: 0}
  offerCount: 0
  offerPrice: 0
  objectives:
  - type: 1
    text: "\uC370\uB9E4 \uC7A5\uC778\uC5D0\uAC8C \uBAA8\uD53C 3\uC7A5 \uAC00\uC838\uB2E4\uC8FC\uAE30"
    targetId: north_sledmaker
    item: {fileID: 11400000, guid: 1a2fc2ad478bf45eb8826708d861bb18, type: 2}
    vehicle: {fileID: 0}
    count: 3
    completeLine: "\uC88B\uC740 \uBAA8\uD53C\uB85C\uAD70! \uBC14\uB85C \uC370\uB9E4\uC5D0
      \uAE54\uACA0\uB124. \uAC12\uC774 \uC880 \uB098\uAC00\uB2C8 \uB3C8\uC744 \uBAA8\uC544
      \uB450\uAC8C."
  - type: 7
    text: "\uC370\uB9E4 \uAC12 320\uB0E5 \uBAA8\uC73C\uAE30"
    targetId: 
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 320
    completeLine: 
  - type: 6
    text: "\uC21C\uB85D \uACE0\uC6D0 \uC7A5\uD130\uC5D0\uC11C \uC21C\uB85D \uC370\uB9E4
      \uC0AC\uAE30"
    targetId: 
    item: {fileID: 0}
    vehicle: {fileID: 11400000, guid: fe513768e4d8d4b289301536cf9f0a44, type: 2}
    count: 1
    completeLine: 
  - type: 5
    text: "\uC370\uB9E4\uB97C \uD0C0\uACE0 \uBE44\uB974\uCE74 \uB0A8\uCABD \uBD81\uBB38
      \uB9C8\uC744\uAE4C\uC9C0 \uB2EC\uB9AC\uAE30"
    targetId: north_c_gatetown
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 1
    completeLine: 
  - type: 0
    text: "\uC370\uB9E4 \uC7A5\uC778\uC5D0\uAC8C \uC370\uB9E4 \uC790\uB791\uD558\uAE30"
    targetId: north_sledmaker
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 1
    completeLine: "\uB208\uBCF4\uB77C \uC18D\uC5D0\uC11C\uB3C4 \uC21C\uB85D\uC774
      \uAE38\uC744 \uC544\uB294 \uBC95\uC774\uC9C0. \uD558\uB974 \uB140\uC11D\uD55C\uD14C\uB3C4
      \uAF2D \uBCF4\uC5EC \uC8FC\uAC8C!"
  rewardMoney: 60
