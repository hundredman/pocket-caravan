  id: north_q8_sled
  title: "\uB208\uBCF4\uB77C\uB97C \uB2EC\uB9AC\uB294 \uC370\uB9E4"
  chain: "\uBD81\uCABD\uC758 \uAE38"
  summary: "\uD558\uB974\uAC00 \uC21C\uB85D \uACE0\uC6D0\uC758 \uC370\uB9E4 \uC7A5\uC778\uACFC
    \uC9D0 \uC370\uB9E4\uB97C \uB9CC\uB4E0\uB2E4. \uAE54\uAC1C\uB85C \uC4F8 \uBAA8\uD53C\uB97C
    \uAC00\uC838\uB2E4\uC8FC\uACE0, \uC21C\uB85D \uACE0\uC6D0 \uC7A5\uD130\uC5D0\uC11C
    \uC370\uB9E4\uB97C \uC0AC\uC11C \uAD6D\uACBD \uACE0\uAC1C \uB108\uBA38 \uBD81\uBB38
    \uB9C8\uC744\uAE4C\uC9C0 \uB2EC\uB824 \uBCF8\uB2E4."
  giverNpc: north_har
  requires:
  - {fileID: 11400000, guid: ac84adc9db6ec4c3bb27dcb61b94b8c5, type: 2}
  offerLine: "\uC190\uC218\uB808\uB85C\uB294 \uB208\uAE38\uC5D0\uC11C \uBC14\uD034\uAC00
    \uBE60\uC9C0\uC9C0. \uACE0\uC6D0\uC758 \uC370\uB9E4 \uC7A5\uC778 \uB140\uC11D\uC774\uB791
    \uC9D0 \uC370\uB9E4\uB97C \uB9CC\uB4E4\uAE30\uB85C \uD588\uB124. \uAE54\uAC1C\uB85C
    \uC4F8 \uBAA8\uD53C \uC138 \uC7A5\uB9CC \uAC00\uC838\uB2E4\uC8FC\uACA0\uB098?
    \uB2E4 \uB418\uBA74 \uACE0\uC6D0 \uC7A5\uD130\uC5D0 \uB0B4\uB193\uACA0\uB124."
  giveItem: {fileID: 0}
  giveCount: 0
  offerItem: {fileID: 0}
  offerCount: 0
  offerPrice: 0
  objectives:
  - type: 1
    text: "\uD558\uB974\uC5D0\uAC8C \uBAA8\uD53C 3\uC7A5 \uAC00\uC838\uB2E4\uC8FC\uAE30"
    targetId: north_har
    item: {fileID: 11400000, guid: 1a2fc2ad478bf45eb8826708d861bb18, type: 2}
    vehicle: {fileID: 0}
    count: 3
    completeLine: "\uC88B\uC740 \uBAA8\uD53C\uB85C\uAD70! \uC774\uC81C \uACE0\uC6D0\uC73C\uB85C
      \uBCF4\uB0B4 \uC370\uB9E4\uC5D0 \uAE54\uACA0\uB124. \uAC12\uC774 \uC880 \uB098\uAC00\uB2C8
      \uB3C8\uC744 \uBAA8\uC544 \uB450\uAC8C."
  - type: 7
    text: "\uC370\uB9E4 \uAC12 320\uB0E5 \uBAA8\uC73C\uAE30"
    targetId: 
    item: {fileID: 0}
    vehicle: {fileID: 0}
    count: 320
    completeLine: 
  - type: 6
    text: "\uC21C\uB85D \uACE0\uC6D0 \uC7A5\uD130\uC5D0\uC11C \uC21C\uB85D \uC370\uB9E4
