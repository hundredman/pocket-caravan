  legacyRewardCredit: 0
  finishNote: "\uC9D0\uB9D0\uC744 \uC5BB\uC5C8\uB2E4! \uC9D0\uC744 50\uAE4C\uC9C0 \uC2E3\uACE0 \uD070\uAE38\uC5D0\uC11C \uBE60\uB974\uB2E4."
