  rewardCredit: 2
  finishNote: "\uC21C\uB85D \uC370\uB9E4\uB97C \uC5BB\uC5C8\uB2E4! \uB208\uBC2D\uC5D0\uC11C
    \uBE60\uB974\uACE0 \uC9D0\uC744 40\uAE4C\uC9C0 \uC2E3\uB294\uB2E4. \uB208\uBCF4\uB77C\uC5D0\uB3C4
