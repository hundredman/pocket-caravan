  - type: 1
    text: "\uac1c\uacbd \uac1d\uc8fc\uc5d0\uac8c \uc885\uc774 2\uac1c \ub0a9\ud488"
    targetId: gaekju
    item: {fileID: 11400000, guid: c7b553013268140eca99e3276caecd4f, type: 2}
    vehicle: {fileID: 0}
    count: 2
    completeLine: "\ub2e5\ub098\ubb34 \ub9c8\uc744 \uc885\uc774\ub85c\uad70. \uc190\ub2d8 \uc55e\uc5d0 \ub0b4\ub193\uae30 \uc88b\uaca0\uc5b4."
  - type: 1
    text: "\uac1c\uacbd \uac1d\uc8fc\uc5d0\uac8c \uc778\uc0bc 2\uac1c \ub0a9\ud488"
    targetId: gaekju
    item: {fileID: 11400000, guid: 34ab4741f86eb44b3bae564c5daa0f12, type: 2}
    vehicle: {fileID: 0}
    count: 2
    completeLine: "\uc774\uc81c \uc0c1\uc774 \ub2e4 \ucc28\ub824\uc84c\ub124! \uc790\ub124 \uac19\uc740 \uc0c1\uc778\uc774\uba74 \uadc0\ud55c \uc9d0\ub3c4 \ubbff\uace0 \ub9e1\uae30\uc9c0."
