  requires:
  - {fileID: 11400000, guid: 6cd6250073664ca2911955a2765affe2, type: 2}
  requiresAny: []
  choiceGroup: 
  offerLine: "\uace7 \ud314\uad00\ud68c\uc77c\uc138. \uc1a1\ub098\ub77c \uc0c1\uc778\uacfc \uba3c \ub370 \uc190\ub2d8\ub4e4\uc774 \uac1c\uacbd\uc5d0 \ubaa8\uc774\ub2c8, \uace0\ub824 \ubb3c\uac74\uc73c\ub85c \uc0c1\uc744 \ucc28\ub824\uc57c\uc9c0. \ub2e5\ub098\ubb34 \ub9c8\uc744 \uc885\uc774 \ub450 \ubb36\uc74c, \uc1a1\uc545 \uc778\uc0bc \ub450 \ubfcc\ub9ac\ub97c \ubaa8\uc544 \uc624\uac8c. \uc138 \ub9c8\uc744\uc744 \ub3c4\ub294 \ud070 \uc8fc\ubb38\uc774\ub124."
