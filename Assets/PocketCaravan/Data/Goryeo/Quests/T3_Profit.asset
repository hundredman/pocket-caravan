  requiresAny: []
  choiceGroup: 
  offerLine: "\uC885\uC774 \uACE0\uB9D9\uB124. \uC778\uC0BC\uC740 \uC5EC\uB7EC \uACF3\uC5D0\uC11C
    \uC774 \uAC1C\uACBD \uC7A5\uD130\uB85C \uBAA8\uC778\uB2E4\uB124. \uCD08\uBCF4
    \uC0C1\uC778\uC5D0\uAC8C \uB0B4 \uC778\uC0BC 3\uBFCC\uB9AC\uB97C \uD558\uB098\uC5D0
    22\uB0E5, \uBAA8\uB450 66\uB0E5\uC5D0 \uB118\uACA8\uC8FC\uACA0\uB124. \uB098\uB8E8\uC5D0\uC11C
    \uD314\uC544 \uBCF4\uB418 \uBA3C\uC800 \uC6D0\uAC00\uC640 \uD310\uB9E4\uAC00\uB97C
