  requires:
  - {fileID: 11400000, guid: 671321731ba25b9d905da5f205300409, type: 2}
  requiresAny: []
  choiceGroup: 
  offerLine: "\uBC30\uB85C \uC57D\uC7AC\uAC00 \uB4E4\uC5B4\uC654\uB294\uB370 \uB2E5\uB098\uBB34
    \uB9C8\uC744\uC5D0\uC11C \uAE09\uD788 \uCC3E\uB294\uB2E4\uB124. \uC885\uC774
    \uB728\uB2E4 \uB2E4\uCE5C \uC0AC\uB78C\uC774 \uB9CE\uC544\uC11C \uB9D0\uC774\uC57C.
    \uAC1C\uACBD\uC744 \uC9C0\uB098 \uB3D9\uBB38 \uBC16\uC774\uB2C8 \uC870\uAE08
    \uBA40\uC9C0\uB9CC, \uC218\uACE0\uBE44\uB294 \uB109\uB109\uD788 \uC8FC\uACA0\uB124.
    \uC7A5\uD130 \uC606 \uAC8C\uC2DC\uD310\uC5D0 \uAC19\uC740 \uCABD \uC758\uB8B0\uAC00
    \uC788\uC73C\uBA74 \uAC19\uC774 \uB9E1\uC544 \uAC00\uAC8C."
