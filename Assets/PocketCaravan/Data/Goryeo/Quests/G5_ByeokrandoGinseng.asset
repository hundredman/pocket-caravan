  chain: "\uace0\ub824 \uc0c1\ub2e8 \u00b7 \ud070 \uac70\ub798"
  summary: "\uc608\uc131\uac15 \ud558\ub958 \ubcbd\ub780\ub3c4\uc5d0 \uc1a1\ub098\ub77c \ubc30\uac00 \ub4e4\uc5b4\uc654\uc2b5\ub2c8\ub2e4. \uc1a1\uc545 \uc0b0\ub85d \uc7a5\ud130\uc5d0\uc11c \uc778\uc0bc \ub450 \ubfcc\ub9ac\ub97c \uc0ac\uc11c \ub098\ub8e8 \ub9c8\uc744 \ucd0c\uc7a5\uc5d0\uac8c \uc804\ud574 \uc8fc\uc138\uc694. \ucd0c\uc7a5\uc774 \uc1a1 \uc0c1\uc778\uc5d0\uac8c \ub118\uaca8 \uc90d\ub2c8\ub2e4."
