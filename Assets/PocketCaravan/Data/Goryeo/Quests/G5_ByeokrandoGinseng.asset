  requiresAny: []
  choiceGroup: 
  offerLine: "\ubcbd\ub780\ub3c4\uc5d0 \uc1a1\ub098\ub77c \ubc30\uac00 \ub2ff\uc558\ub2e4\ub124. \uc1a1 \uc0c1\uc778\uc774 \uace0\ub824 \uc778\uc0bc\uc744 \ucc3e\ub294\ub370, \ub0b4\uac00 \ub300 \uc8fc\uae30\ub85c \ud588\uc9c0. \uc1a1\uc545 \uc0b0\ub85d\uc5d0\uc11c \uc778\uc0bc \ub450 \ubfcc\ub9ac\ub97c \uc0ac\ub2e4 \uc8fc\uaca0\ub098? \uac12\uc740 \uc790\ub124\uac00 \uba3c\uc800 \uce58\ub974\uace0, \ub118\uaca8 \uc8fc\uba74 \uc148\ud574 \uc8fc\uaca0\ub124."
