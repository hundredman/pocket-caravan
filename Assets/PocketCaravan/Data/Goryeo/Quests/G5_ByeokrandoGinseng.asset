  - type: 1
    text: "\ub098\ub8e8 \ub9c8\uc744 \ucd0c\uc7a5\uc5d0\uac8c \uc778\uc0bc 2\uac1c \ub0a9\ud488"
    targetId: naru_chief
    item: {fileID: 11400000, guid: 34ab4741f86eb44b3bae564c5daa0f12, type: 2}
    vehicle: {fileID: 0}
    count: 2
    completeLine: "\uc88b\uc740 \uc778\uc0bc\uc77c\uc138. \uc1a1 \uc0c1\uc778\uc774 \ubc18\uae30\uaca0\uad70. \uc8fc\ubb38\ubc1b\uc740 \ubb3c\uac74\uc744 \uc81c\ub54c \ub300 \uc8fc\ub294 \uc0c1\uc778\uc774\ub77c\uba74 \ub2e4\uc74c\uc5d0\ub3c4 \uc77c\uc744 \ub9e1\uae30\uc9c0."
