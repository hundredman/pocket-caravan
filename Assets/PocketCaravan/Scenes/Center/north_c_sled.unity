  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uC370\uB9E4\uAFBC"
  lines:
  - "\uC544\uB798\uCABD \uD2B8\uB799 \uCD9C\uBC1C\uB300\uC5D0\uC11C 20\uB0E5 \uB0B4\uBA74
    \uC5B8\uB355 \uC370\uB9E4 \uD55C \uD310! \uB098\uBB34 \uD53C\uD558\uACE0 \uB208\uC1A1\uC774
    \uBAA8\uC73C\uBA74 \uC0C1\uAE08\uC744 \uC918."
  - "\uD1B5\uB098\uBB34\uB294 Space\uB85C \uB6F0\uC5B4\uB118\uC5B4. \uB0B4 \uCD5C\uACE0
    \uAE30\uB85D\uC740 \uC544\uC9C1 \uC544\uBB34\uB3C4 \uBABB \uAE7C\uC9C0."
  - "\uC9D0 \uC2E3\uB294 \uC370\uB9E4\uB294 \uC21C\uB85D \uACE0\uC6D0\uC758 \uD558\uB974
    \uB2D8\uC774 \uD5C8\uB77D\uD574\uC57C \uBE4C\uB824\uC904 \uC218 \uC788\uC5B4."
