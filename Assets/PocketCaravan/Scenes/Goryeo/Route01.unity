  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uC8FC\uBAA8"
  lines:
  - "\uBA3C \uAE38 \uAC00\uC2DC\uC624? \uAC1C\uACBD \uB0A8\uBB38\uAE4C\uC9C0\uB294
    \uC2DC\uB0B4 \uAC74\uB108 \uD55C\uCC38\uC774\uC624. \uC26C\uC5C8\uB2E4 \uAC00\uC2DC\uAD6C\uB824."
  - "\uC9D0\uC218\uB808\uB77C\uBA74 \uC774 \uC55E \uD070 \uB2E4\uB9AC\uB85C \uAC00\uC2DC\uC624.
    \uB113\uC740 \uAE38\uC774\uB77C \uBC14\uD034\uAC00 \uC798 \uAD6C\uB974\uC624."
  - "\uB4F1\uC9D0\uC774 \uAC00\uBCBC\uC6B0\uBA74 \uC11C\uCABD \uAC08\uB9BC\uAE38\uC5D0\uC11C
    \uC232\uAE38\uB85C \uAC00\uB3C4 \uB418\uC624. \uC791\uC740 \uB2E4\uB9AC\uB97C
    \uAC74\uB108\uBA74 \uB0A8\uBB38 \uAE38\uC5D0\uC11C \uB2E4\uC2DC \uB9CC\uB098\uC624."
