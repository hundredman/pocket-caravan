  greeting: "\uB9E4\uB4ED\uC740 \uD2BC\uD2BC\uD558\uB124. \uC774\uC81C \uC5B4\uB514\uB85C
    \uAC08\uC9C0 \uC815\uD558\uBA74 \uB418\uACA0\uC5B4. \uB3D9\uCABD \uD070\uAE38\uB85C
    \uAC00\uBA74 \uB18D\uC6D0\uAE38, \uADF8 \uB05D\uC774 \uC790\uBE44\uB4DC\uC57C.
    \uC9D0\uC774 \uBB34\uAC70\uC6B8\uC218\uB85D \uAC78\uC74C\uC774 \uB290\uB824\uC9C0\uB2C8
