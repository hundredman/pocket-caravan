  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uC0C1\uC778 \uC870\uD569\uC7A5 \uD558\uD0B4"
  lines:
  - "\uB124 \uB300\uB959 \uC0C1\uC778\uC774 \uBAA8\uB450 \uC774 \uD68C\uAD00\uC5D0
    \uC7A5\uBD80\uB97C \uB9E1\uAE30\uC9C0. \uC2E0\uC6A9\uC774 \uC313\uC774\uBA74
    \uBB38\uC774 \uB354 \uB113\uAC8C \uC5F4\uB9B0\uB2E4\uB124."
  - "\uAE43\uBC1C \uB137\uC740 \uC0C1\uC778\uD68C\uC758 \uB124 \uAE38\uB4DC\uB77C\uB124.
    \uAE08\uC800\uC6B8, \uBC14\uB78C\uAE38, \uC19C\uC528, \uB3D9\uBB34\uD68C. \uD328\uB97C
    \uBC1B\uC73C\uBA74 \uC5B4\uB290 \uAE43\uBC1C \uC544\uB798 \uC124\uC9C0 \uACE8\uB77C
    \uBCF4\uAC8C."
