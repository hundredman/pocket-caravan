  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uAD00\uB78C\uCC28 \uC0AC\uACF5"
  lines:
  - "\uAF2D\uB300\uAE30\uC5D0 \uC624\uB974\uBA74 \uB4F1\uBD88 \uD0D1, \uC5F4\uAE30\uAD6C,
    \uC800 \uBA40\uB9AC \uC0AC\uB9C9\uAE4C\uC9C0 \uB2E4 \uBCF4\uC5EC\uC694!"
  - "\uD55C \uBC14\uD034 \uB3C4\uB294 \uB370 \uB178\uB798 \uD55C \uACE1\uC774\uC5D0\uC694.
    \uC7A5\uB0A0 \uBC24\uC5D4 \uBD88\uAF43\uC774 \uBC14\uB85C \uB208\uC55E\uC5D0\uC11C
    \uD130\uC9C0\uC8E0."
