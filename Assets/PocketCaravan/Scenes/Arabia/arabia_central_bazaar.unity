  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 0
  displayName: "\uC774\uC815\uD45C"
  lines:
  - "\uB9CC\uAD6D \uC7A5\uD130 \uC548\uB0B4\n\uAC00\uC6B4\uB370: \uC2DC\uACC4\uD0D1
    \uAD11\uC7A5 \xB7 \uBD81\uC11C: \uC6B4\uD558 \uAC70\uB9AC(\uC720\uB9AC \uACF5\uBC29)
    \xB7 \uBD81\uB3D9: \uB098\uBB34 \uC7A5\uC6D0 \uAC70\uB9AC\n\uB3D9: \uAE30\uC640
    \uACE8\uBAA9 \xB7 \uB0A8: \uACF5\uC5F0 \uB9C8\uB2F9 \xB7 \uB0A8\uC11C: \uB5A0\uB3CC\uC774
    \uC0C1\uC778 \uC57C\uC601\uC9C0 \xB7 \uBD81\uBB38: \uD55C\uAC00\uC6B4\uB370 \uCD08\uC6D0"
