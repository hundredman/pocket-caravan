  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 0
  displayName: "\uC774\uC815\uD45C"
  lines:
  - "\uB9CC\uAD6D \uC7A5\uD130 \uB300\uAD11\uC7A5\n\uAC00\uC6B4\uB370: \uB300\uBD84\uC218
    \xB7 \uBD81: \uB4F1\uBD88 \uD0D1\uACFC \uCD08\uC6D0 \uB300\uB85C \xB7 \uBD81\uC11C:
    \uAC70\uC6B8 \uC5F0\uBABB \uC815\uC6D0\n\uBD81\uB3D9: \uCD95\uC81C \uCC9C\uB9C9
    \uAC70\uB9AC(\uB180\uC774\xB7\uC810\uC220\xB7\uC5F4\uAE30\uAD6C) \xB7 \uB3D9:
    \uC57C\uC2DC\uC7A5 \xB7 \uB0A8\uB3D9: \uB9CC\uAD6D \uBC31\uD654\uC810\xB7\uAD00\uB78C\uCC28\xB7\uBCF4\uC11D\xB7\uC5EC\uD589
    \uC7A5\uBE44\n\uB0A8: \uACF5\uC5F0 \uB9C8\uB2F9 \xB7 \uB0A8\uC11C: \uC0C1\uC778
    \uC870\uD569 \uD68C\uAD00\xB7\uB5A0\uB3CC\uC774 \uC0C1\uC778 \uC57C\uC601\uC9C0"
