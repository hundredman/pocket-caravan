  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uAE38\uC190"
  lines:
  - "\uC218\uB808\uB294 \uB0A8\uCABD \uD070\uAE38\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.
    \uAC00\uBCCD\uAC8C \uAC78\uC744 \uB54C\uB294 \uC232\uAE38\uC774 \uC9E7\uC9C0\uC694."
  - "\uC9D0\uC774 \uB9CE\uC744\uC218\uB85D \uB290\uB824\uC9D1\uB2C8\uB2E4. \uD754\uB4E4\uB824\uB3C4
    \uD654\uBB3C\uC774 \uB5A8\uC5B4\uC9C0\uC9C0\uB294 \uC54A\uC544\uC694."
