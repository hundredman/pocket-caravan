  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uAE38\uC190"
  lines:
  - "\uC11C\uCABD \uAE38\uC744 \uB530\uB77C\uAC00\uBA74 \uB0B4\uB959 \uAD50\uC5ED
    \uAE38\uBAA9\uC758 \uC27C\uD130\uAC00 \uB098\uC635\uB2C8\uB2E4. \uACE0\uB824\uC5D0\uC11C
    \uC5EC\uB7EC \uACE0\uAC1C\uC640 \uB9C8\uC744\uC744 \uC9C0\uB098 \uC5EC\uAE30\uAE4C\uC9C0
    \uC624\uC168\uAD70\uC694. \uB098\uBB34\uAC00 \uC904\uACE0 \uB9C8\uB978 \uCD08\uC6D0\uC774
    \uB113\uC5B4\uC9D1\uB2C8\uB2E4."
  - "\uC9D0\uC218\uB808\uB294 \uB2E8\uB2E8\uD55C \uD070\uAE38\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.
    \uAC00\uBCCD\uB2E4\uBA74 \uC624\uC194\uAE38\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694."
