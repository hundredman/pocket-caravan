  blocksMovement: 1
  displayName: "\uAE38\uC190"
  lines:
  - "\uC11C\uCABD \uAE38\uC744 \uB530\uB77C\uAC00\uBA74 \uB0B4\uB959 \uAD50\uC5ED
    \uAE38\uBAA9\uC758 \uC27C\uD130\uAC00 \uB098\uC635\uB2C8\uB2E4. \uACE0\uB824\uC5D0\uC11C
