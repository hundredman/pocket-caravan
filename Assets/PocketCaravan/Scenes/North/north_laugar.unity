  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uBAA9\uC695 \uD68C\uAD00 \uC8FC\uC778"
  lines:
  - "\uC5BC\uC5B4\uBD99\uC740 \uAE38\uC744 \uAC74\uB108\uC654\uAD6C\uBA3C. \uBAB8\uBD80\uD130
    \uB179\uC774\uACE0 \uAC00\uAC8C."
  - "\uD0D5 \uAC00\uC7A5\uC790\uB9AC\uC5D0\uC11C Space\uB97C \uB204\uB974\uBA74 \uBAB8\uC744
    \uB2F4\uAE00 \uC218 \uC788\uC5B4.\n\uD55C\uBC88 \uB179\uC774\uACE0 \uB098\uBA74
    \uB208\uBCF4\uB77C \uC18D\uC744 \uAC78\uC5B4\uB3C4 \uD55C\uB3D9\uC548 \uB35C
    \uC9C0\uCE58\uC9C0."
  - "\uC628\uCC9C\uBB3C\uC5D0 \uB2F4\uADFC \uC57D\uCD08\uB294 \uC798 \uC0C1\uD558\uC9C0
    \uC54A\uC544\uC11C, \uBA40\uB9AC \uAC00\uC838\uAC00\uB3C4 \uAC12\uC774 \uB35C
    \uB5A8\uC5B4\uC9C0\uC9C0."
