  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uC0C1\uC778 \uAE38\uB4DC\uC7A5"
  lines:
  - "\uAE38\uB4DC \uC7A5\uBD80\uC5D4 \uBAA8\uB4E0 \uB9C8\uC744\uC758 \uC2DC\uC138\uAC00
    \uC801\uD600 \uC788\uC9C0.\n\uC2F8\uAC8C \uC0AC\uC11C \uBA3C \uACF3\uC5D0 \uD314\uBA74
    \uAE38\uB4DC\uAC00 \uC790\uB124\uB97C \uAE30\uC5B5\uD560 \uAC78\uC138."
  - "\uC232 \uB108\uBA38 \uC0AC\uB0E5\uAFBC \uB9C8\uC744\uC5D0 \uAC00\uBA74 \uBAA8\uD53C\uAC00
    \uC2F8.\n\uC5EC\uAE30\uC11C\uB294 \uAC12\uC744 \uB450 \uBC30\uB294 \uCCD0\uC8FC\uC9C0.\n\uAC78\uC5B4\uC11C\uB294
    \uB208\uBC2D \uC9C0\uB984\uAE38, \uC218\uB808\uB294 \uD070\uAE38\uB85C \uB3CC\uC544\uAC00\uAC8C."
