  m_Script: {fileID: 11500000, guid: 39725ff5a67c7406595a62c3d0226b03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PocketCaravan.TalkNpc
  blocksMovement: 1
  displayName: "\uB8EC \uC9C0\uAE30 \uB178\uC778"
  lines:
  - "\uC774 \uACE0\uB9AC\uC758 \uB8EC\uB3CC\uB4E4\uC740 \uC624\uB798\uB41C \uC774\uC57C\uAE30\uB97C
    \uD488\uACE0 \uC788\uC9C0.\n\uBD81\uCABD \uB545 \uACF3\uACF3\uC5D0 \uD769\uC5B4\uC9C4
    \uB8EC\uB3CC\uC744 \uCC3E\uC544 \uC77D\uC5B4 \uBCF4\uAC8C."
  - "\uC228\uC740 \uB8EC\uB3CC\uC740 \uC77C\uACF1 \uAC1C\uB77C\uB124.\n\uBC24\uC774\uBA74
    \uC740\uC740\uD788 \uBE5B\uB098\uC9C0.\n\uC77C\uACF1 \uC870\uAC01\uC744 \uB2E4
    \uC77D\uACE0 \uBCC4\uBE5B \uC544\uB798 \uC774 \uACE0\uB9AC \uD55C\uAC00\uC6B4\uB370\uC5D0
