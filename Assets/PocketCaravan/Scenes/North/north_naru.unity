  blocksMovement: 1
  displayName: "\uAE38\uC190"
  lines:
  - "\uBD81\uCABD \uAC08\uB9BC\uAE38\uC5D0 \uD2B8\uB864 \uD328\uAC70\uB9AC\uAC00
    \uC0B0\uB2E4\uB354\uAD70.\n\uB77C\uC6B0\uAC00\uB974\uB85C \uAC00\uB294 \uC9C0\uB984\uAE38\uC778\uB370,
    \uD1B5\uD589\uB8CC\uB97C \uB0B4\uAC70\uB098 \uB0C5\uB2E4 \uB2EC\uB824\uC57C \uD574."
  - "\uD2B8\uB864\uC774 \uC2EB\uC73C\uBA74 \uC11C\uCABD \uBE44\uB974\uCE74\uB85C
    \uB3CC\uC544\uAC00\uAC8C.\n\uBA40\uC5B4\uB3C4 \uADF8\uCABD \uAE38\uC740 \uC870\uC6A9\uD558\uC9C0."
