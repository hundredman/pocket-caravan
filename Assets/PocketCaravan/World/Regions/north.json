  "npcs": [
    {
      "id": "north_innkeeper",
      "name": "여관 할머니",
      "sprite": "north_bear_granny_tall",
      "greeting": "어서 오렴. 못 하나로도 수프를 끓이는 집이 여기란다. 일거리는 저 게시판에 붙어 있지."
    },
    {
      "id": "north_husband",
      "name": "집 보는 남편",
      "sprite": "north_fox_man_tall",
      "greeting": "오늘은 내가 집을 보기로 했는데… 버터는 안 굳고 소는 울고, 이게 무슨 일인지."
    },
    {
      "id": "north_wife",
      "name": "들일 하는 아내",
      "sprite": "north_fox_woman_tall",
      "greeting": "들일이 집안일보다 쉬울 줄 알았지? 남편은 지금쯤 진땀 빼고 있을 거야."
    },
    {
      "id": "north_goats",
      "name": "그루프 염소 맏형",
      "sprite": "north_goat_tall",
      "greeting": "음메. 우리 셋은 다리 건너 이 목장에 살아. 다리 밑 트롤만 없으면 좋으련만."
    },
    {
      "id": "north_har",
      "name": "목수 하르",
      "sprite": "north_moose_tall",
      "greeting": "형은 부자지만 나는 손재주뿐이지. 그래도 내 손수레는 눈길에서도 안 부서져."
    },
    {
      "id": "north_warehouse",
      "name": "창고지기",
      "sprite": "north_lynx_tall",
      "greeting": "꿀술 통은 무거워서 수레가 있으면 한결 편하지. 창고 문 앞엔 작은 할아버지가 산다는 소문도 있고."
    },
    {
      "id": "north_bold",
      "name": "욕심쟁이 형 볼드",
      "sprite": "north_wolf_viking_tall",
      "greeting": "이 몸이 비르카에서 제일가는 부자 볼드다! 사는 것도 파는 것도 멈추는 법을 모르지."
    }
  ],
  "villagers": [
    {
      "name": "뱃사공",
      "sprite": "north_bear_sailor_tall",
      "lines": [
        "피오르가 꽁꽁 얼어서 배가 묶였어. 얼음이 녹을 때까지는 걸어서 다녀야지.",
        "얼음이 녹으면 이 배로 나루 마을까지 금방이야."
      ]
    },
    {
      "name": "사냥꾼",
      "sprite": "north_wolf_tall",
      "lines": [
        "숲 너머 사냥꾼 마을에 가면 모피가 싸. 여기서는 값을 두 배는 쳐주지.",
        "길 없는 눈밭도 걸어서 가면 지름길이야. 수레를 끌 땐 큰길로 돌아가는 게 낫고."
      ]
    }
  ]
}
