  "npcs": [
    {
      "id": "arabia_hasan",
      "name": "길잡이 하산",
      "sprite": "arabia_npc_scholar_tall",
      "greeting": "매듭은 튼튼하네. 이제 어디로 갈지 정하면 되겠어. 동쪽 큰길로 가면 농원길, 그 끝이 자비드야. 짐이 무거울수록 걸음이 느려지니 실을 양을 골라 봐. (Space 대화 · Q 수첩 · L 장부 · Shift 달리기)"
    },
    {
      "id": "arabia_maryam",
      "name": "여관 주인 마리암",
      "sprite": "arabia_woman_grandma_tall",
      "greeting": "그 가방, 낯이 익구나. 옆 장터에 가져다줄 것이 있으면 힌드바드가 먼저 나눠 맡길 거야. 첫 배달을 마치고 오면 나도 부탁할 일이 있단다."
    },
    {
      "id": "arabia_hindbad",
      "name": "짐꾼 힌드바드",
      "sprite": "arabia_npc_sailor_tall",
      "greeting": "휴, 바구니가 이렇게 많을 줄은 몰랐어. 다음에도 일손이 필요하면 부를게."
    },
    {
      "id": "arabia_kitchen_keeper",
      "name": "공동 부엌 담당",
      "sprite": "arabia_woman_baker_tall",
      "greeting": "자비드 공동 부엌이야. 오늘 저녁도 여러 집이 함께 먹지. 곡물은 큰길 남쪽 장터에서 살 수 있어."
    },
    {
      "id": "arabia_elder",
      "name": "차 마시는 노인",
      "sprite": "arabia_npc_scholar_tall",
      "greeting": "자비드 찻집은 소문이 모이는 곳이지. 앉아서 한 잔 하고 가게. 바다 건너 제다 소식도 여기서 먼저 들린다네."
    },
    {
      "id": "arabia_rashid",
      "name": "직물 상인 라시드",
      "sprite": "arabia_npc_merchant_tall",
      "greeting": "타이즈 직물은 바다 건너에서도 알아주지. 좋은 양탄자가 있으면 내가 산다네."
    },
    {
      "id": "arabia_dyer",
      "name": "염색 장인",
      "sprite": "arabia_woman_weaver_tall",
      "greeting": "쪽빛은 세 번, 꼭두서니는 두 번 담가야 고운 색이 나와요. 소금이 있어야 색이 붙지요."
    },
    {
      "id": "arabia_portmaster",
      "name": "물류 담당",
      "sprite": "arabia_npc_sailor_tall",
      "greeting": "배가 들어오면 창고가 하루 만에 차고 하루 만에 비네. 장부를 잘 적어야 살아남지."
    },
    {
      "id": "arabia_yusuf",
      "name": "수레 장인 유수프",
      "sprite": "arabia_npc_bedouin_tall",
      "greeting": "낙타 없이 사막을 건너는 건 바보나 하는 짓이지. 안장은 내가 손봐 주마."
    },
    {
      "id": "arabia_nadia",
      "name": "시장 상인 나디아",
      "sprite": "arabia_woman_perfumer_tall",
      "greeting": "수도 장터엔 없는 게 없지만, 없는 게 하나 있지. 바로 타이즈 커피야."
    },
    {
      "id": "arabia_gardener",
      "name": "정원사",
      "sprite": "arabia_woman_grandma_tall",
      "greeting": "궁전 정원엔 대추야자가 있어야 해. 알 아흐사 것이 제일 달지."
    }
  ],
  "villagers": [
    {
      "name": "대추야자 농부",
      "sprite": "arabia_npc_weaver_tall",
      "lines": [
        "오아시스 물길 덕분에 대추야자가 잘 익어.",
        "같은 물건도 멀리 가져갈수록 값이 오르지만, 한꺼번에 많이 팔면 금방 떨어져."
      ]
    },
    {
      "name": "바구니 든 주민",
      "sprite": "arabia_woman_girl_tall",
      "lines": [
        "게시판에는 선금 없이 맡는 배달 의뢰도 붙어.",
        "돈이 모자라면 배달부터 해서 밑천을 모으는 상인도 많아."
      ]
    },
    {
      "name": "곡물 장수",
      "sprite": "arabia_woman_bedouinWoman_tall",
      "lines": [
        "자비드 곡물은 알 아흐사 여관에서 늘 찾아.",
        "산 값은 장부에 남겨 둬. 받은 돈이 전부 이익은 아니니까."
      ]
    }
  ]
}