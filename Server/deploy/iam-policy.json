{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GameTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:ACCOUNT_ID:table/baribari"
    },
    {
      "Sid": "BackupFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/auto/*"
    },
    {
      "Sid": "BackupList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": { "StringLike": { "s3:prefix": "auto/*" } }
    }
  ]
}
